# systemd user service: cp to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now RakazoBridge
[Unit]
Description=RakazoBridge
After=network-online.target

[Service]
WorkingDirectory=%h/RakazoBridge
EnvironmentFile=%h/RakazoBridge/.env
ExecStart=/usr/bin/env node server.mjs
Restart=on-failure

[Install]
WantedBy=default.target
