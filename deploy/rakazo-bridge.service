# systemd user service: cp to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now rakazo-bridge
[Unit]
Description=rakazo-bridge
After=network-online.target

[Service]
WorkingDirectory=%h/rakazo-bridge
EnvironmentFile=%h/rakazo-bridge/.env
ExecStart=/usr/bin/env node server.mjs
Restart=on-failure

[Install]
WantedBy=default.target
