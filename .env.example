# RakazoBridge configuration. Copy to .env and fill in. See README → "Setup guide".
# Values below match the recommended setup: the bridge runs on the same host as a
# self-hosted Rakazo, agents reach it over a private network (e.g. Tailscale).

# Where the bridge listens. 0.0.0.0 lets both your private network and the Rakazo
# containers reach it; every route except /health and /openapi.json needs a token.
# Use a specific IP (e.g. your Tailscale IP) to listen on one interface only.
HOST=0.0.0.0
PORT=7480

# The URL Rakazo's reply tool calls. Must be reachable from inside the Rakazo
# containers, e.g. the host's Tailscale or LAN IP: http://100.x.y.z:7480
PUBLIC_URL=http://<host-private-ip>:7480

# Bearer tokens for external agents, comma-separated (one per agent).
# Generate each with: openssl rand -hex 32
CALLER_TOKENS=

# Bearer token the Rakazo reply tool sends to /reply. Generate: openssl rand -hex 32
BOT_TOKEN=

BOTS_CONFIG=./bots.json

# Rakazo API. On the same host as the docker-compose install, the api is published
# on 127.0.0.1:3100. Otherwise use your public Rakazo URL. Overrides rakazoUrl in bots.json.
RAKAZO_URL=http://127.0.0.1:3100

# Seconds /ask waits for a reply before returning 202 "pending".
ASK_TIMEOUT_S=120
# How long answers stay available at /result/:id.
RESULT_TTL_S=3600
RATE_LIMIT_PER_MIN=30
MAX_MESSAGE_CHARS=32000
