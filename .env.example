# Where the bridge listens. Bind to a private/tailnet IP, not a public one.
HOST=127.0.0.1
PORT=7480
# URL Rakazo uses to call /reply (goes into openapi.json "servers").
PUBLIC_URL=http://127.0.0.1:7480
# Comma-separated bearer tokens for external agents (one per agent). Generate: openssl rand -hex 32
CALLER_TOKENS=
# Bearer token the Rakazo reply tool sends to /reply. Generate: openssl rand -hex 32
BOT_TOKEN=
BOTS_CONFIG=./bots.json
# Optional: overrides rakazoUrl in bots.json
# RAKAZO_URL=http://127.0.0.1:3100
ASK_TIMEOUT_S=120
RESULT_TTL_S=3600
RATE_LIMIT_PER_MIN=30
MAX_MESSAGE_CHARS=32000
